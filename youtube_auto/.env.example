# ============================================================
#  YouTube Automation Pipeline - Variables d'environnement
#  Copiez ce fichier en .env et remplissez vos cles GRATUITES.
# ============================================================

# --- Images libres de droits ---
# Gratuit : https://www.pexels.com/api/  (200 req/heure)
PEXELS_API_KEY=

# Gratuit : https://pixabay.com/api/docs/  (100 req/heure)
PIXABAY_API_KEY=

# --- Generation de script ---
# Optionnel si vous utilisez Ollama (use_ollama: true dans config.yaml)
# Gratuit (free tier) : https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- YouTube Data API v3 ---
# Gratuit (10 000 unites/jour) : https://console.cloud.google.com
# Le fichier client_secrets.json est telecharge depuis Google Cloud Console.
# Indiquez ici le chemin si different de la racine du projet.
YOUTUBE_CLIENT_SECRETS=client_secrets.json
